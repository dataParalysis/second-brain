# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace-me

# Your numeric Telegram user ID (get it from @userinfobot)
ALLOWED_USER_ID=123456789

# OpenRouter API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=replace-me

# Tried in order when a model/provider is unavailable or returns an error.
# OpenRouter bills according to the model that handles the request.
OPENROUTER_MODELS=google/gemini-4-carbon,openai/gpt-6.2-sol,anthropic/claude-fable-5.2

# Set to false to commit locally without pushing
GIT_PUSH=true
